# =============================================================================
# Shezmin — environment template
# Copy to `.env` and fill in. Every variable declared in src/lib/env.ts is
# listed below, grouped by service. "prod-required" = the app fails closed at
# boot in production if it is missing (see PRODUCTION_REQUIRED in env.ts).
# Never commit real secrets — keep values here blank/example only.
# =============================================================================

# ---- Core ----
# Runtime mode. Leave as development locally; set to production in deploy env.
NODE_ENV=development

# ---- Database (Postgres) ----
# prod-required. Pooled connection string. Neon/Supabase/RDS dashboard.
# May include ?connection_limit=..&pgbouncer=true when pooled.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace?schema=public
# Direct (non-pooled) URL used ONLY by `prisma migrate`/introspection. Same DB
# as DATABASE_URL but a plain, non-pooled connection. Required to run migrations.
DIRECT_URL=

# ---- Redis (BullMQ jobs) ----
# prod-required. Upstash/Redis Cloud connection URL (rediss://... for TLS).
REDIS_URL=redis://localhost:6379

# ---- NextAuth ----
# prod-required. Session/JWT signing secret (min 16 chars). `openssl rand -base64 32`.
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Canonical deployment origin for NextAuth callbacks. e.g. https://shezmin.com
AUTH_URL=
# Trust the host header behind a proxy (Vercel/Fly). Read directly by NextAuth.
AUTH_TRUST_HOST=true

# ---- Claude API (AI listings, search intent, translation) ----
# Optional. Anthropic console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Phone OTP (Twilio Verify) ----
# Optional. In dev, leave blank to use the stubbed OTP (code: 123456).
# Twilio console: Account SID + Auth Token; Verify service SID from Verify > Services.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Object storage (S3 or Cloudflare R2) ----
# Optional (uploads disabled if unset). R2/S3 dashboard.
S3_ENDPOINT=
# Region; "auto" for R2. Defaults to "auto" when unset.
S3_REGION=auto
S3_BUCKET=marketplace-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL that serves objects (CDN/bucket public URL).
S3_PUBLIC_BASE_URL=

# ---- Background removal (Remove.bg or self-hosted rembg) ----
# Optional. https://www.remove.bg/api
REMOVE_BG_API_KEY=

# ---- Avatar video (Higgsfield) ----
# Optional. Higgsfield API key for runtime avatar-video generation.
HIGGSFIELD_API_KEY=
# Cost kill-switch: set to "false" to skip avatar-video generation even when the
# key is present. Absent/any other value = enabled.
AVATAR_VIDEO_ENABLED=

# ---- Stripe (US-side payments) ----
# prod-required (secret + webhook secret). https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# prod-required. Signing secret from Stripe > Developers > Webhooks.
STRIPE_WEBHOOK_SECRET=

# ---- Razorpay (India payments + RazorpayX payouts) ----
# prod-required (key id + secret). https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# prod-required. Webhook signing secret from Razorpay > Settings > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
# prod-required. RazorpayX source account number that payout funds are debited from.
RAZORPAY_ACCOUNT_NUMBER=

# ---- Shiprocket (logistics) ----
# Optional. Shiprocket account email + password (API user).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Shared secret authenticating inbound Shiprocket tracking webhooks. Fails CLOSED
# in production when absent. Set the same value in the Shiprocket webhook config.
SHIPROCKET_WEBHOOK_SECRET=
# Nickname of a pickup location configured in the Shiprocket dashboard. Defaults
# to "Primary" when unset.
SHIPROCKET_PICKUP_LOCATION=Primary

# ---- KYC — Signzy (primary provider: PAN / GSTIN / Udyam) ----
# Optional (seller KYC disabled/stubbed if unset). Provided by your Signzy account.
# When set, seller KYC is verified against Signzy. Confirm all paths against your
# Signzy account — defaults are best-effort.
SIGNZY_BASE_URL=
SIGNZY_USERNAME=
SIGNZY_PASSWORD=
# Optional tenant/realm sent on the Signzy login call (some accounts require it).
SIGNZY_REALM=
# Endpoint paths relative to SIGNZY_BASE_URL. May contain a {userId} placeholder.
# Defaults applied in env.ts when blank; override only if your account differs.
SIGNZY_LOGIN_PATH=/api/backopsusers/login
SIGNZY_PAN_PATH=/api/v3/getpandetails
SIGNZY_GSTIN_PATH=/api/v3/gstin
# Optional: only set when the account has an Udyam/MSME verification endpoint.
SIGNZY_UDYAM_PATH=

# ---- KYC — legacy generic provider (SUPERSEDED by SIGNZY_* above) ----
# Optional. Used only when no SIGNZY_* creds are present. Prefer migrating to Signzy.
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_BASE_URL=

# ---- Transactional email (Resend) ----
# Optional. https://resend.com/api-keys — key enables real sends.
RESEND_API_KEY=
# Verified "From" address, e.g. "Shezmin <no-reply@shezmin.com>".
EMAIL_FROM=

# ---- Observability (Sentry) ----
# Optional. DSN activates server/edge/worker error capture. Sentry > Project Settings.
SENTRY_DSN=
# Environment tag (defaults to NODE_ENV when unset).
SENTRY_ENVIRONMENT=
# Source-map upload at build time — all three needed for the build integration.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Logging ----
# Optional. Structured-log verbosity (defaults to "info" when unset).
LOG_LEVEL=

# ---- Seed scripts (prisma/seed.ts) ----
# Optional. Google Gemini API key used for generated seed imagery.
GEMINI_API_KEY=

# =============================================================================
# Public (client-exposed) — NEXT_PUBLIC_* are bundled into the browser build.
# =============================================================================

# Public app URL. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public site origin (canonical URLs, emails, sitemaps). e.g. https://shezmin.com
NEXT_PUBLIC_SITE_URL=
# Optional. Stripe publishable key (public). https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional. Client-side Sentry DSN (public, exposed to browsers).
NEXT_PUBLIC_SENTRY_DSN=
# Optional. Client-side Sentry environment tag.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
